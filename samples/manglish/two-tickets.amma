// A1, A2, B1 and B2 are four different tickets on two routes.
// Draw twice with replacement. How often is the route the same?
routes = ["A", "A", "B", "B"]
outcomes = 0
same_route = 0
same_ticket = 0
0 muthal 3 vare {
    first = _
    0 muthal 3 vare {
        second = _
        outcomes += 1
        ithu routes[first] == routes[second] sathyamo {
            same_route += 1
        }
        ithu first == second sathyamo {
            same_ticket += 1
        }
    }
}
// Among 16 equally likely pairs, 8 match by route and 4 by ticket.
parayuka outcomes
parayuka same_route
parayuka same_ticket
